    {
      "parameters": {
        "text": "={{ $json.text }}",
        "attributes": {
          "attributes": [
            {
              "name": "invoice_number",
              "description": "The invoice or document reference number, however it's labeled — commonly appears as 'Invoice Number', 'Invoice No.', 'Document No.', 'Bill No.', 'Reference No.', or similar. Extract whichever one appears."
            },
            {
              "name": "company_name",
              "description": "Name of the company/biller issuing the invoice"
            },
            {
              "name": "description",
              "description": "Short description of the invoice/service"
            },
            {
              "name": "account_number",
              "description": "Payee's bank account number, if present"
            },
            {
              "name": "bank_name",
              "description": "Payee's bank name, if present"
            },
            {
              "name": "biller_code",
              "description": "JomPay biller code, if present"
            },
            {
              "name": "jompay_ref",
              "description": "JomPay reference number, if present"
            },
            {
              "name": "amount",
              "type": "number",
              "description": "Total amount due — numeric only, no currency symbol"
            },
            {
              "name": "invoice_date",
              "description": "The invoice date. Source dates may be numeric and ambiguous (e.g., \"07/08/2026\" could mean 7 August or July 8th depending on the format used). If either number in the date is greater than 12, that position must be the day (since months only go up to 12) — use this to determine the correct format. Always output in ISO format YYYY-MM-DD."
            },
            {
              "name": "due_date",
              "description": "The payment due date. Use the same date format interpretation as invoice_date — a single invoice should use one consistent format throughout, not mix conventions between its own dates. Note: on a typical invoice, the due date is usually on or after the invoice date, but this isn't a hard rule — an overdue/reminder notice can legitimately show a due date earlier than the notice's own date. Use this only as a loose sanity check, not a reason to override what the source text actually shows. Always output in ISO format YYYY-MM-DD."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "You are a precise invoice data-extraction assistant. Extract exactly the fields defined in the schema. If a field isn't found in the text, return an empty string."
        }
      },
